# MICEMORE AI Gateway — 환경변수 샘플
# 실제 값은 .env (git ignored) 또는 AWS Lambda 환경변수 콘솔에서 설정.
#
# ╔══════════════════════════════════════════════════════════════════════╗
# ║ USE_MOCK 토글 동작 정리                                                ║
# ║                                                                      ║
# ║ true (기본값 — 키 없이도 실행 가능)                                      ║
# ║   ┌──────────────────────────────────────────────────────────────┐  ║
# ║   │ • 코파일럿: 가짜 SSE — citations + 영/한/일/중 고정 응답 토큰  │  ║
# ║   │ • 통역:    audio.end 시 mock 대본 (한·영 7-turn) round-robin  │  ║
# ║   │ • ML 리드: 룰베이스 v0 그대로 (Phase 2 leads/scorer)         │  ║
# ║   │ • 페르소나: 8 클러스터 결정론 더미 (Phase 4 personas/clusterer)│  ║
# ║   │ • 매칭/트렌드/동선: 모두 결정론 mock                          │  ║
# ║   └──────────────────────────────────────────────────────────────┘  ║
# ║                                                                      ║
# ║ false (실 키 필요)                                                    ║
# ║   ┌──────────────────────────────────────────────────────────────┐  ║
# ║   │ • Pinecone 검색 → Claude streaming → 출처 인용                │  ║
# ║   │ • Whisper STT → Claude 번역 → ElevenLabs TTS                 │  ║
# ║   │ • XGBoost 추론 (200건+ 도달 시) — 미만이면 자동 룰베이스 폴백  │  ║
# ║   │ • UMAP+HDBSCAN 클러스터링 (5,000건+ 도달 시)                 │  ║
# ║   └──────────────────────────────────────────────────────────────┘  ║
# ╚══════════════════════════════════════════════════════════════════════╝

# === 모드 ===
# 시연/CI/dev 권장값: true
# 베타 행사 D-7 부터 false 로 전환 + 키 채움
USE_MOCK=true
LOG_LEVEL=INFO
DEPLOY_ENV=dev               # dev | staging | prod

# === LLM (USE_MOCK=false 시 필수) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=900
# Claude 5xx → GPT-4o 자동 폴백
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# === Vector DB (USE_MOCK=false 시 필수) ===
PINECONE_API_KEY=...
PINECONE_INDEX=micemore-booths
PINECONE_NAMESPACE_PREFIX=booth     # booth:{boothId} 패턴

# === RAG 튜닝 ===
RAG_TOP_K=5
RAG_CONFIDENCE_FLOOR=0.55           # 미만이면 폴백 메시지
INGEST_CHUNK_CHARS=1200
INGEST_CHUNK_OVERLAP=120

# === ML 리드 스코어링 게이트 ===
# 누적 VisitorBehavior 가 MIN_TRAINING_SAMPLES 미만 → 룰베이스 v0 강제
ML_MIN_TRAINING_SAMPLES=200
ML_AB_RATIO=0.50                    # ML/룰 50/50 A/B (sha1 hash 기반 결정론)
ML_DRIFT_PSI_ALERT=0.25
MODEL_S3_BUCKET=                    # ml/train.py 로 학습한 모델 저장
MODEL_VERSION=v1

# === 페르소나 클러스터링 게이트 ===
PERSONAS_MIN_SAMPLES=5000           # 미만이면 mock 분포만 표시 + banner

# === 통역 (Phase 2 Sprint 2~3) ===
WHISPER_MODEL=whisper-1             # 또는 gpt-4o-mini-transcribe
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_KO=             # 한국어 voice id
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_JA=
ELEVENLABS_VOICE_ID_ZH=
TRANSLATION_BUDGET_DAILY_USD=20     # 초과 시 TTS off (text only) 자동 전환

# === Follow-up 메일 ===
SENDGRID_API_KEY=
FROM_EMAIL=noreply@micemore.com
CALENDLY_INTEGRATION=true

# === 인사이트 리포트 ===
REPORT_DELIVERY_HOUR=24             # 행사 종료 후 +Nh 발송
REPORT_TEMPLATE_VERSION=v1

# === MyPass 거버넌스 ===
MYPASS_GEOFENCE_RADIUS_M=20
MYPASS_MIN_INTERVAL_MIN=5

# === 매칭 거버넌스 (Phase 4-A) ===
MATCH_QUANTIZE_RADIUS_M=50          # GPS 50m 그리드 양자화
MATCH_K_ANONYMITY_MIN=30
MATCH_PUSH_LIMIT_BOOTH=10           # 부스 일일 push 한도
MATCH_PUSH_LIMIT_VISITOR=5

# === CORS / 운영 ===
CORS_ORIGINS=https://micemore-participant.web.app,https://micemore-organizer.web.app,http://localhost:3000
SENTRY_DSN=
SENTRY_TRACES=0.1

# === Firebase Admin (Cloud Function 통신) ===
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-admin.json

# === 한국관광공사 OpenAPI (2026 관광데이터 활용 공모전 — 8개 오퍼레이션 활용) ===
# 발급: api.visitkorea.or.kr → 인증키 신청 (무료, 24h 승인)
# 활용 API 8종:
#   [UI 호출용]
#   1. searchFestival2     — 행사/축제 검색 (다음 행사 매칭)
#   2. locationBasedList2  — 부스 GPS 주변 관광지/숙박/음식점
#   [RAG 학습 인제스트용]
#   3. areaBasedList2      — 지역별 contentid 시드
#   4. areaBasedSyncList2  — 일일 변경분 (incremental, API 호출량 90% 절감)
#   5. detailCommon2       — 콘텐츠 본문 텍스트 (overview)
#   6. detailIntro2        — 운영 메타 (입장료·주차·휴일·운영시간)
#   7. detailInfo2         — 반복 정보 (객실·메뉴·코스 단계)
#   [다국어 동시]
#   8. EngService2 / JpnService2 / ChsService2 — 4개 언어 RAG 학습
# PLACEHOLDER 면 mock 자동 폴백. 실값 주입 시 자동 활성화 + 인제스트 가능.
KTO_TOURAPI_KEY=PLACEHOLDER

# === RAG 인제스트 — Pinecone 별도 인덱스 (관광 데이터 전용) ===
# 부스 자료(micemore-booths) 와 분리하여 관광 데이터만 별도 인덱스에 저장.
# namespace 패턴: tour:{lang}:{areacode} (예: tour:en:35)
PINECONE_TOUR_INDEX=micemore-tour
KTO_CHUNK_CHARS=1000
KTO_CHUNK_OVERLAP=100
